---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import FigureScene from '../../components/FigureScene.astro';
import NotesPanel from '../../components/NotesPanel.astro';
import Arrow from '../../components/Arrow.astro';
import { entryFor } from '../../data/journey';
import { keepDots, nobrCompounds, sentence } from '../../lib/format';

export async function getStaticPaths() {
  const cases = await getCollection('cases');
  return cases.map((c) => ({ params: { slug: c.id }, props: { entry: c, all: cases } }));
}

const { entry, all } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const ordered = [...all].sort((a, b) => a.data.order - b.data.order);
const { entry: journeyEntry, chapter } = entryFor(entry.id);
// Cases read in order ("Case 2 of 5"), so each offers the next; the last offers the first again.
const at = ordered.findIndex((c) => c.id === entry.id);
const next = ordered[(at + 1) % ordered.length];
const last = at + 1 === ordered.length;
---

<Base title={`${d.title} · Kaushik Kallam`} description={d.question} current="work">
  <main id="main" class="case" data-page-name={d.title} data-case={entry.id} data-chapter={chapter.id} data-chapter-title={chapter.label}>
    <div class="case__layout">
      <article class="case__article" aria-labelledby="case-title">
        <header class="case__head">
          <h1 id="case-title" class:list={['case__title', { 'case__title--long': d.title.length > 25 }]}><span class="case__title-text" style={`view-transition-name: case-${entry.id}`}>{d.title}</span></h1>
          <p class="case__crumbs">
            <span>{keepDots(d.context)}</span>
            <span>Case {d.order} of {ordered.length}</span>
            {d.draft && <span class="draft-marker" title="Draft copy awaiting Kaushik’s confirmation">Draft</span>}
          </p>
          <p class="case__question"><Fragment set:html={nobrCompounds(d.question)} /></p>
        </header>

        <dl class="tldr" aria-label="Summary">
          <div><dt>Contribution</dt><dd>{d.contribution}</dd></div>
          {d.team && <div><dt>Team</dt><dd>{d.team}</dd></div>}
          <div><dt>Timeline</dt><dd>{d.timeline}</dd></div>
          {d.methods && <div><dt>Methods</dt><dd><ul>{d.methods.map((m) => <li>{m}</li>)}</ul></dd></div>}
          <div class="tldr__outcome"><dt>Outcome <span class="tldr__type">{d.outcomeType}</span></dt><dd>{d.outcome}</dd></div>
        </dl>

        <div class="case__figure" data-observe-reach="figure" data-observe-shows={sentence(`You reached the figure in ${d.title}`)} data-observe-cannot="Whether it made the idea clearer than the words.">
          {journeyEntry.figure && <FigureScene kind={journeyEntry.figure} />}
        </div>

        <div class="prose" data-observe-reach="method" data-observe-shows={sentence(`You reached the account of the research in ${d.title}`)} data-observe-cannot="Whether you read it closely or looked for the result.">
          <Content />
        </div>

        <section class="limits" aria-labelledby="limits-title" data-observe-reach="limits" data-observe-shows={sentence(`You reached what the evidence can’t show in ${d.title}`)} data-observe-cannot="Whether it changed how you read the rest.">
          <h2 id="limits-title" class="limits__title">What the evidence shows, and what it can’t</h2>
          <div class="limits__cols">
            <div>
              <h3 class="limits__h">Shows</h3>
              <ul>{d.shows.map((s) => <li>{s}</li>)}</ul>
            </div>
            <div class="limits__cannot">
              <h3 class="limits__h">Can’t show</h3>
              <ul>{d.cannotShow.map((s) => <li>{s}</li>)}</ul>
            </div>
          </div>
          <p class="limits__status"><span class="label">Status</span> {keepDots(d.status)}</p>
        </section>

        <nav class="case__next" aria-label="Where next">
          <a class="case__return" href={`/#${chapter.id}`} data-return data-case-id={entry.id} data-chapter-id={chapter.id} data-chapter-title={chapter.label} data-observe="case.return" data-observe-label="Return" data-observe-cannot="Whether you finished reading.">
            <Arrow to="left" />
            <span class="case__return-label" data-return-label>Explore {chapter.label}</span>
          </a>
          <ul class="case__more">
            <li><a class="link link--under" href="/work/" data-observe="case.all-work" data-observe-label="All selected work" data-observe-cannot="Whether you are comparing cases.">All selected work <Arrow /></a></li>
            {next.id !== entry.id && (
              <li>
                <a class="link link--under" href={`/work/${next.id}/`} aria-label={last ? `Back to the first case: ${next.data.title}` : undefined} data-case-link={next.id} data-case-title={next.data.title} data-observe={`case.${next.id}`} data-observe-label={last ? 'Back to the first case' : `Next case: ${next.data.title}`} data-observe-cannot="Whether you are reading them all or looking for one.">
                  {last ? 'Back to the first case' : `Next case: ${next.data.title}`} <Arrow />
                </a>
              </li>
            )}
            <li><a class="link link--under" href="/#contact" data-observe="case.contact" data-observe-label="Get in touch" data-observe-cannot="Whether you will write.">Get in touch <Arrow /></a></li>
          </ul>
        </nav>
      </article>
      <div class="case__rail">
        <div class="case__rail-sticky"><NotesPanel /></div>
      </div>
    </div>
  </main>
</Base>

<script>
  import { returnTargetFor } from '../../lib/origin';
  import { adoptOrigin } from '../../scripts/navigation';
  import { KEYS, session } from '../../lib/store';

  // Return goes back to the reader's Origin. When the Origin is the page right behind us, use real history,
  // so the browser restores scroll and state exactly; otherwise navigate and restore on arrival.
  const a = document.querySelector<HTMLAnchorElement>('[data-return]');
  if (a) {
    const caseRef = { id: a.dataset.caseId!, chapterId: a.dataset.chapterId!, chapterTitle: a.dataset.chapterTitle! };
    document.body.dataset.caseId = caseRef.id;
    const origin = adoptOrigin(caseRef.id);
    const target = returnTargetFor(caseRef, origin);
    a.href = target.href;
    a.querySelector('[data-return-label]')!.textContent = target.label;
    const ref = document.referrer ? new URL(document.referrer) : null;
    const cameFromOrigin =
      !!origin && !!ref && ref.origin === location.origin && ref.pathname === new URL(target.href, location.href).pathname;
    a.addEventListener('click', (ev) => {
      if (cameFromOrigin && history.length > 1) {
        ev.preventDefault();
        session.set(KEYS.restore, { scrollY: null, focusId: target.focusId });
        history.back();
        return;
      }
      session.set(KEYS.restore, { scrollY: target.scrollY, focusId: target.focusId });
    });
  }
</script>

<style>
  .case { padding-top: 64px; }
  .case__layout { position: relative; --rail: clamp(250px, 22vw, 340px); display: grid; grid-template-columns: minmax(0, 1fr) var(--rail); gap: var(--gutter); padding-inline: var(--margin); }
  .case__rail-sticky { position: sticky; top: 88px; margin-top: clamp(40px, 8vw, 120px); }
  .case__article { container-type: inline-size; padding-bottom: clamp(80px, 10vw, 160px); }
  .case__head { padding-top: clamp(40px, 7vw, 110px); max-width: 1100px; }
  .case__crumbs { margin-top: 18px; display: flex; flex-wrap: wrap; gap: 4px 0; color: var(--ink-3); align-items: center; font-size: var(--t-meta); }
  /* The dot ends the part before it, so a wrapped line never starts with one. */
  .case__crumbs > span:has(+ span:not(.draft-marker))::after { content: '·' / ''; padding: 0 0.3em; }
  .case__crumbs > .draft-marker { margin-left: 14px; }
  .case__title {
    /* The box hugs the words, like the title it travels from, so the two scale alike in the transition. */
    width: fit-content;
    font-size: clamp(2.8rem, 8cqi, 6rem);
    line-height: 0.92;
    letter-spacing: -0.04em;
    font-weight: 530;
    max-width: 14ch;
  }
  /* Long titles step down so the question and summary still share the first screen. */
  .case__title--long { font-size: var(--t-page-long); max-width: 18ch; }
  /* The words that travel from a row title: a box measured by line height, like the row's own words. */
  .case__title-text { display: inline-block; }
  .case__question { margin-top: clamp(22px, 3vw, 40px); font-size: var(--t-lede); line-height: 1.32; letter-spacing: -0.015em; max-width: 34ch; }

  .tldr {
    margin: clamp(40px, 6vw, 80px) 0 0;
    /* Rows fill themselves: a Case without a Team line has three facts across, never an empty fourth cell. */
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--gutter);
    border-top: 1px solid var(--ink);
    max-width: 1100px;
  }
  .tldr div { flex: 1 1 220px; padding: 14px 0 18px; border-bottom: 1px solid var(--rule); }
  .tldr dt { font-size: var(--t-small); color: var(--ink-3); margin-bottom: 4px; }
  .tldr dd { margin: 0; font-size: var(--t-meta); }
  .tldr ul { display: grid; gap: 4px; }
  .tldr .tldr__outcome { flex-basis: 100%; }
  .tldr__outcome dd { font-size: var(--t-body); max-width: 58ch; }
  .tldr__type { color: var(--ink); font-weight: 520; margin-left: 6px; }
  .tldr__type::before { content: '·'; color: var(--ink-3); margin-right: 6px; font-weight: 400; }

  .case__figure { margin-top: clamp(40px, 6vw, 80px); max-width: 900px; }

  .prose { margin-top: clamp(48px, 7vw, 100px); max-width: 56ch; }
  .prose :global(h2) {
    font-size: var(--t-h3);
    line-height: 1.1;
    letter-spacing: -0.028em;
    font-weight: 520;
    margin: 2.2em 0 0.6em;
  }
  .prose :global(h2:first-child) { margin-top: 0; }
  .prose :global(p) { margin-bottom: 1em; line-height: 1.62; }
  .prose :global(strong) { font-weight: 560; }

  .limits { margin-top: clamp(56px, 8vw, 110px); max-width: 1100px; border-top: 1px solid var(--ink); padding-top: 18px; }
  .limits__title { font-size: var(--t-h3); letter-spacing: -0.028em; line-height: 1.1; font-weight: 520; max-width: 22ch; }
  .limits__cols { margin-top: 28px; display: grid; grid-template-columns: 1fr 1fr; gap: var(--gutter); }
  .limits__h { font-size: var(--t-meta); font-weight: 520; margin-bottom: 10px; }
  .limits ul { display: grid; gap: 10px; }
  .limits li { border-top: 1px dotted var(--rule); padding-top: 10px; }
  .limits__cannot li { color: var(--ink-2); }
  .limits__status { margin-top: 26px; font-size: var(--t-meta); max-width: 56ch; }

  .case__next { margin-top: clamp(64px, 9vw, 130px); display: grid; gap: 28px; max-width: 1100px; }
  .case__return {
    display: flex;
    align-items: baseline;
    gap: 0.4em;
    font-size: var(--t-row);
    text-decoration: none;
    border-top: 1px solid var(--ink);
    padding-top: 14px;
  }
  .case__return :global(.arrow) { width: 0.5em; height: 0.5em; flex: none; transition: translate 0.8s var(--ease-out); }
  .case__return-label { letter-spacing: -0.04em; line-height: 0.95; font-weight: 520; }
  .case__return:hover :global(.arrow) { translate: -8px 0; }
  .case__more { display: flex; flex-wrap: wrap; gap: 10px 28px; font-weight: 520; }
  @media (pointer: coarse) { .case__more { row-gap: 22px; } }
  @media (max-width: 520px) { .case__more { flex-direction: column; align-items: flex-start; } }

  @media (max-width: 1100px) {
    .case__layout { grid-template-columns: minmax(0, 1fr); }
    .case__rail { order: 2; }
    .case__rail-sticky { position: static; margin-top: 0; }
  }
  @media (max-width: 700px) {
    .limits__cols { grid-template-columns: 1fr; }
  }
</style>
