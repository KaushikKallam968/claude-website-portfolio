---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
---

<Base title="Not found · Kaushik Kallam">
  <main id="main" class="nf" data-page-name="a page that doesn’t exist">
    <h1 class="nf__title">This page doesn’t exist.</h1>
    <p class="nf__note mono">can’t tell: what you expected to find here, or how you got here.</p>
    <p class="nf__text">The journey, the selected work and the résumé are all still where they were.</p>
    <ul class="nf__links">
      <li><a class="link link--under" href="/" data-observe="404.journey" data-observe-label="The journey" data-observe-cannot="What you were looking for.">The journey <Arrow /></a></li>
      <li><a class="link link--under" href="/work/" data-observe="404.work" data-observe-label="Selected work" data-observe-cannot="What you were looking for.">Selected work <Arrow /></a></li>
      <li><a class="link link--under" href="/resume/" data-observe="404.resume" data-observe-label="Résumé" data-observe-cannot="What you were looking for.">Résumé <Arrow /></a></li>
      <li><a class="link link--under" href="/#contact" data-observe="404.contact" data-observe-label="Get in touch" data-observe-cannot="What you were looking for.">Get in touch <Arrow /></a></li>
    </ul>
  </main>
</Base>

<style>
  .nf { min-height: 100svh; padding: 140px var(--margin) 80px; display: grid; align-content: center; gap: 18px; max-width: 1200px; }
  .nf__title { font-size: var(--t-page); line-height: 0.88; letter-spacing: -0.04em; font-weight: 530; }
  .nf__note { color: var(--note); font-size: var(--t-small); margin-top: 0.6em; }
  .nf__text { font-size: var(--t-lede); letter-spacing: -0.015em; max-width: 34ch; }
  .nf__links { display: flex; flex-wrap: wrap; gap: 10px 28px; font-weight: 520; margin-top: 8px; }
  @media (pointer: coarse) { .nf__links { row-gap: 22px; } }
</style>
