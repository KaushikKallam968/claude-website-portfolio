---
import Base from '../layouts/Base.astro';
import ChapterSection from '../components/ChapterSection.astro';
import Prologue from '../components/Prologue.astro';
import NotesPanel from '../components/NotesPanel.astro';
import Arrow from '../components/Arrow.astro';
import { chapters, closing, shortPlace } from '../data/journey';
import { keepDots } from '../lib/format';

const pad = (v: number) => String(v).padStart(2, '0');
// The Field draws the world from these: every Chapter's place, in page order.
const fieldPlaces = chapters.map((c) => ({
  id: c.id,
  label: c.label,
  short: shortPlace(c),
  lat: c.place.lat,
  lon: c.place.lon,
  tz: c.place.timeZone,
}));
---

<Base title="Kaushik Kallam · Senior Quantitative UX Researcher" current="journey">
  <script type="application/json" id="field-places" set:html={JSON.stringify(fieldPlaces)} />
  <main id="main" data-page-name="the journey">
    <div class="layout">
    <section class="hero" aria-labelledby="name">
      <div class="hero__top">
      <h1 id="name" class="hero__name" aria-label="Kaushik Kallam">
        <span class="hero__line" aria-hidden="true"><span class="hero__word" data-split>Kaushik</span></span>
        <span class="hero__line hero__line--2" aria-hidden="true"><span class="hero__word" data-split>Kallam</span></span>
      </h1>

      <div class="hero__id" data-quiet>
        <p class="hero__role" data-reveal>Senior Quantitative UX Researcher<br /><span>JPMorganChase, New York</span></p>
        <p class="hero__lede" data-reveal>I’m interested in the gaps between what people need, how products behave, and what the data can explain.</p>
      </div>
      </div>
      <div class="hero__grid grid">
        <div class="hero__more" data-quiet>
          <p class="hero__sub" data-reveal>I’ve lived across countries, worked across research disciplines, and co-founded watched., a movie and TV discovery app, with two longtime friends. New York is my latest stop. This is the journey that brought me here.</p>
          <ul class="hero__actions" data-reveal>
            <li><a class="link link--under" href="#journey" data-observe="cta.journey" data-observe-label="Explore the journey" data-observe-cannot="Whether you have time for the whole thing.">Explore the journey <Arrow to="down" /></a></li>
            <li><a class="link link--under" href="/work/" data-observe="cta.work" data-observe-label="Selected work" data-observe-cannot="Whether you would rather skip straight to the evidence.">Selected work <Arrow /></a></li>
            <li><a class="link link--under" href="/resume/" data-observe="cta.resume" data-observe-label="Résumé" data-observe-cannot="Whether a recruiter is reading this.">Résumé <Arrow /></a></li>
          </ul>
        </div>
      </div>

      <nav class="route grid" aria-label="Chapters of the journey" id="journey-index" data-quiet>
        <ol class="route__list">
          {chapters.map((c, i) => (
            <li>
              <a href={`#${c.id}`} class="route__item" data-observe={`route.${c.id}`} data-observe-label={c.label} data-observe-cannot="Whether you will jump there or keep scrolling.">
                <span class="route__no mono num" aria-hidden="true">{pad(i + 1)}</span>
                <span class="route__place">{c.label}</span>
                <span class="route__work">{keepDots(c.work)}</span>
                <span class="route__meta mono num"><span>{c.period}</span> <span data-clock={c.place.timeZone} aria-hidden="true">--:--</span></span>
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </section>

    <!-- The notes come before the journey in the source, so Pause live is reached early by keyboard; the
         margin is positioned beside the journey either way. -->
    <div class="rail">
      <div class="rail__sticky"><NotesPanel /></div>
    </div>
    <div id="journey" class="journey">
      <Prologue first={chapters[0]} last={chapters[chapters.length - 1]} />
      {chapters.map((c, i) => <ChapterSection chapter={c} previous={chapters[i - 1]} />)}
    </div>
    </div>

    <section class="close" id="contact" aria-labelledby="close-title" data-chapter-section="contact" data-chapter-title="Contact">
      <div class="grid">
        <h2 id="close-title" class="close__title" tabindex="-1" data-quiet>Your visit, as this site saw it</h2>
        <div class="close__text" data-quiet>
          <p class="close__honest">This is everything this site could observe. It can’t tell me what you were looking for, so I’d rather ask.</p>
          <p>{closing.text}</p>
          <p class="close__email"><a class="link link--under" href={`mailto:${closing.email}`} data-observe="contact.email" data-observe-label="my email address" data-observe-cannot="Whether you will write.">{closing.email}</a></p>
          <ul class="close__links">
            <li><a class="link link--under" href={closing.linkedin} rel="me" data-observe="contact.linkedin" data-observe-label="LinkedIn" data-observe-cannot="Whether we are already connected.">LinkedIn <Arrow to="up-right" /></a></li>
            <li><a class="link link--under" href="/resume/" data-observe="contact.resume" data-observe-label="Résumé" data-observe-cannot="Whether it is for you or to pass along.">Résumé <Arrow /></a></li>
            <li><a class="link link--under" href="/work/" data-observe="contact.work" data-observe-label="Selected work" data-observe-cannot="Whether you want to see the evidence again.">Selected work <Arrow /></a></li>
          </ul>
        </div>
        <div class="readout" data-readout>
          <p class="readout__total" data-quiet><span class="mono num" data-readout-total>0 s</span> on this site, up to here</p>
          <p class="readout__empty" data-readout-empty hidden>You haven’t spent a second in any chapter yet.</p>
          <ol class="readout__bars" data-readout-bars aria-label="Time spent in each chapter">
            {chapters.map((c) => (
              <li data-bar={c.id}>
                <span class="readout__label">{c.label}</span>
                <span class="readout__track" aria-hidden="true"><span class="readout__fill"></span></span>
                <span class="readout__value mono num">0 s</span>
              </li>
            ))}
            <li data-bar="outside" class="readout__outside">
              <span class="readout__label">Everywhere else</span>
              <span class="readout__track" aria-hidden="true"><span class="readout__fill"></span></span>
              <span class="readout__value mono num">0 s</span>
            </li>
          </ol>
          <p class="readout__unit" data-visit-unit hidden data-quiet></p>
          <p class="readout__cases" data-readout-cases>No cases opened yet.</p>
          <p class="readout__nojs">With scripts off, this site observed nothing, so there is nothing to chart.</p>
        </div>
      </div>
      <footer class="foot grid">
        <p class="label">© 2026 Kaushik Kallam</p>
        <p class="label">Notes on this visit never leave your browser.</p>
      </footer>
    </section>
  </main>
</Base>

<style>
  /* ---------- Layout: the story in the main column, notes in the margin ---------- */
  .layout { position: relative; --rail: clamp(250px, 22vw, 340px); }
  /* The rail comes before the journey in the source; its own layer keeps it above the journey's links. */
  .rail {
    position: absolute;
    z-index: 2;
    right: var(--margin);
    width: var(--rail);
    top: calc(64px + 36vw);
    /* Level with the paragraph beside it; the estimate above stands where anchors are not supported. */
    top: anchor(--hero-more top, calc(64px + 36vw));
    bottom: 0;
  }
  .rail__sticky { position: sticky; top: 88px; }
  .journey { padding-right: calc(var(--rail) + var(--gutter)); container-type: inline-size; }

  /* ---------- Hero ---------- */
  .hero { padding-top: 64px; position: relative; }
  .hero__name {
    padding-inline: var(--margin);
    /* Width sets the name, unless the screen is short: then height does, so the route index still fits. */
    font-size: clamp(4.2rem, min(18.6vw, 31vh), 23rem);
    line-height: 0.76;
    letter-spacing: -0.04em;
    font-weight: 530;
    margin: clamp(10px, 1.6vw, 28px) 0 0 -0.067em;
  }
  .hero__line { display: block; overflow: clip; padding-bottom: 0.05em; margin-bottom: -0.05em; }
  .hero__line--2 { text-align: right; }
  /* Without the Field the name is its own letters, and the m ends about 0.02em inside the dots the Field draws at the edge. */
  :global(html:not(.field)) .hero__line--2 .hero__word { translate: 0.02em 0; }
  .hero__word { display: inline-block; }

  /* The identity sits in the negative space beside the second half of the name. The two share one grid cell
     rather than the identity floating free, so what follows always clears whichever is taller. */
  .hero__top { display: grid; }
  .hero__name, .hero__id { grid-area: 1 / 1; }
  .hero__id {
    align-self: start;
    margin: calc(18px + min(16.4vw, 27.33vh)) 0 0 var(--margin);
    width: min(40vw, 600px);
    display: grid;
    align-content: start;
    gap: 14px;
  }
  .hero__role { font-size: var(--t-lede); line-height: 1.3; font-weight: 520; letter-spacing: -0.02em; }
  .hero__role span { font-weight: 400; color: var(--ink-2); }
  .hero__lede { font-size: var(--t-lede); line-height: 1.3; letter-spacing: -0.015em; max-width: 31ch; }

  .hero__grid { margin-top: clamp(26px, 3vw, 48px); padding-right: calc(var(--margin) + var(--rail) + var(--gutter)); anchor-name: --hero-more; }
  .hero__more { grid-column: 1 / span 8; display: grid; gap: 16px; }
  .hero__sub { color: var(--ink-2); max-width: 52ch; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 10px 28px; font-weight: 520; }
  /* Touch hit areas are 44px tall; wrapped rows sit far enough apart that they never overlap. */
  @media (pointer: coarse) { .hero__actions { row-gap: 22px; } }
  /* On a phone the three actions stack, one to a row, rather than wrapping two and one. */
  @media (max-width: 520px) { .hero__actions { flex-direction: column; align-items: flex-start; } }

  /* Journey in the top bar lands the index clear of the bar (and, on small screens, the notes ticker). */
  .route { margin-top: clamp(28px, 3.4vw, 52px); padding-right: calc(var(--margin) + var(--rail) + var(--gutter)); scroll-margin-top: 96px; }
  @media (max-width: 1100px) { .route { scroll-margin-top: 132px; } }
  .route__list {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    position: relative;
    --rule-w: 1;
  }
  .route__list::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: var(--ink);
    transform: scaleX(var(--rule-w));
    transform-origin: left;
  }
  /* A little inline room, taken back with a negative margin, so a focus ring sits inside the item and never
     over its neighbour's text. */
  .route__item {
    display: grid;
    gap: 2px;
    padding: 12px 10px 16px 6px;
    margin-left: -6px;
    text-decoration: none;
    position: relative;
    font-size: var(--t-meta);
  }
  .route__item::before {
    content: '';
    position: absolute;
    left: 6px; right: 10px; top: -1px;
    height: 3px;
    background: var(--note);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.7s var(--ease-out);
  }
  .route__item:hover::before, .route__item:focus-visible::before, .route__item[aria-current='true']::before { transform: scaleX(1); }
  .route__item:focus-visible { outline-offset: -2px; }
  .route__no { color: var(--ink-3); }
  .route__place { font-weight: 520; letter-spacing: -0.01em; line-height: 1.2; }
  /* The work under each place, so the first screen names projects, not only cities. */
  .route__work { color: var(--ink-2); font-size: var(--t-small); line-height: 1.3; margin-bottom: 2px; text-wrap: balance; }
  .route__meta { color: var(--ink-3); display: flex; gap: 8px; flex-wrap: wrap; font-size: var(--t-data-s); }

  @media (max-width: 1100px) {
    /* The notes become a fixed ticker here; without a sticky wrapper they layer above the page as they should. */
    .rail { position: static; width: auto; }
    .rail__sticky { position: static; }
    .journey, .hero__grid, .route { padding-right: var(--margin); }
    .journey { padding-right: 0; }
  }
  /* Short laptop screens: the hero's gaps tighten so the route index, and the work it names, is on the first
     screen. */
  @media (min-width: 1241px) and (max-height: 860px) {
    .hero__name { margin-top: 4px; }
    .hero__grid { margin-top: 22px; }
    .hero__more { gap: 8px; }
    .route { margin-top: 14px; }
    .route__item { padding-block: 8px 10px; }
  }
  /* Below about 1240px the identity no longer fits beside the second half of the name: it follows it. */
  @media (max-width: 1240px) {
    .hero__id { grid-area: 2 / 1; margin: 0; width: auto; max-width: 44rem; padding: 28px var(--margin) 0; }
  }
  /* Landscape tablets and small windows: the name is sized by height instead, which leaves room for the identity
     beside it again, so the actions and the route index (the work) are on the first screen, as on a desktop. */
  @media (min-width: 901px) and (max-width: 1240px) and (orientation: landscape) {
    .hero__name { font-size: clamp(4.2rem, min(18.6vw, 22vh), 23rem); margin-top: 4px; }
    .hero__id { grid-area: 1 / 1; margin: calc(18px + min(16.4vw, 19.36vh)) 0 0 var(--margin); width: min(40vw, 600px); max-width: none; padding: 0; }
    .hero__grid { margin-top: 22px; }
    .hero__more { gap: 8px; }
    .route { margin-top: 14px; }
    .route__item { padding-block: 8px 10px; }
  }
  @media (max-width: 900px) {
    .hero__more { grid-column: 1 / -1; }
    .route__list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  /* ---------- Close ---------- */
  /* Arriving by the Contact link skips the section's opening space, so the email is on the first screen. */
  .close { padding-top: clamp(120px, 16vw, 240px); scroll-margin-top: calc(72px - clamp(120px, 16vw, 240px)); }
  /* Where the notes ticker sits under the bar, the landing clears it too. */
  @media (max-width: 1100px) { .close { scroll-margin-top: calc(72px + 44px - clamp(120px, 16vw, 240px)); } }
  .close__title {
    grid-column: 1 / span 10;
    font-size: var(--t-page);
    line-height: 0.9;
    letter-spacing: -0.04em;
    font-weight: 520;
    outline: none;
  }
  /* The visit is the last image: a chart at display scale, drawn (with the Field) in the dots that drew the
     name and the world. */
  .readout { grid-column: 1 / span 8; grid-row: 2; margin-top: clamp(40px, 5vw, 72px); color: var(--note); }
  .readout__total { font-size: var(--t-lede); line-height: 1.3; color: var(--ink-2); margin-bottom: 22px; }
  /* A monospace space is a full digit wide; at this size it would split the number from its unit. */
  .readout__total .mono { font-size: 0.92em; color: var(--note); margin-right: 0.3em; word-spacing: -0.35em; }
  /* One grid for all rows, so every track starts on the same line and lengths compare. */
  .readout__bars { display: grid; grid-template-columns: max-content 1fr max-content; gap: clamp(10px, 1.4vw, 20px) clamp(14px, 2vw, 32px); }
  .readout__bars li { display: grid; grid-column: 1 / -1; grid-template-columns: subgrid; align-items: end; }
  /* Chapters without a second of reading are left out; the empty line says so when that is all of them. */
  .readout__bars li[hidden] { display: none; }
  .readout__empty { color: var(--ink-2); font-size: var(--t-meta); margin-bottom: 18px; }
  .readout__label { color: var(--ink); font-size: var(--t-readout); line-height: 1; letter-spacing: -0.028em; font-weight: 520; white-space: nowrap; }
  .readout__track { height: 14px; background: var(--note-soft); position: relative; overflow: hidden; }
  .readout__fill { position: absolute; inset: 0; background: var(--note); transform: scaleX(var(--share, 0)); transform-origin: left; transition: transform 1.2s var(--ease-out); }
  .readout__outside .readout__label { color: var(--ink-2); }
  .readout__unit { margin-top: 14px; color: var(--note); font-size: var(--t-meta); }
  /* With the Field running, the bars are drawn in dots: the same dots that drew the name and the world. */
  :global(html.field-on) .readout__track { height: clamp(34px, 3.6vw, 52px); background: none; overflow: visible; border-bottom: 1px solid var(--rule); }
  :global(html.field-on) .readout__fill { display: none; }
  .readout__outside .readout__fill { background: var(--ink-3); }
  @media (prefers-reduced-motion: reduce) { .readout__fill { transition: none; } }
  .readout__value { text-align: right; font-size: var(--t-fine); }
  .readout__cases { margin-top: 18px; color: var(--ink-2); font-size: var(--t-meta); }
  /* Without scripts nothing was measured, so no numbers are shown: only a line that says so. */
  .readout__nojs { color: var(--ink-2); font-size: var(--t-lede); line-height: 1.35; max-width: 30ch; }
  :global(html.js) .readout__nojs { display: none; }
  :global(html:not(.js)) .readout > :not(.readout__nojs) { display: none; }
  /* The hand-off leads: it shares the final screen with the portrait, and comes first on narrow screens. */
  .close__text {
    grid-column: 9 / -1;
    grid-row: 2;
    min-width: 0;
    margin-top: clamp(40px, 5vw, 72px);
    display: grid;
    gap: 1em;
    align-content: start;
    font-size: var(--t-lede);
    line-height: 1.35;
    letter-spacing: -0.012em;
  }
  .close__honest { color: var(--note); }
  .close__email { font-size: var(--t-email); letter-spacing: -0.03em; font-weight: 520; margin-top: 0.4em; overflow-wrap: anywhere; }
  .close__links { display: flex; flex-wrap: wrap; gap: 8px 24px; font-size: var(--t-body); }
  @media (pointer: coarse) { .close__links { row-gap: 22px; } }
  /* On short screens (a phone on its side, a laptop at 200% zoom) every line counts. The bar hides as the page
     moves down, so the landing no longer keeps its space (smooth scrolling adds 64px of its own, taken back
     here); the title scales with the height and the hand-off tightens, so the email still fits. */
  @media (max-height: 560px) {
    .close { scroll-margin-top: calc(24px - clamp(120px, 16vw, 240px)); }
    :global(html.lenis) .close { scroll-margin-top: calc(24px - 64px - clamp(120px, 16vw, 240px)); }
    .close__title { font-size: min(var(--t-page), 11vh); }
    .close__text { margin-top: 20px; gap: 0.7em; }
  }
  .foot { margin-top: clamp(80px, 10vw, 160px); padding-block: 22px; border-top: 1px solid var(--rule); }
  .foot p:first-child { grid-column: 1 / span 6; }
  .foot p:last-child { grid-column: 7 / -1; text-align: right; }

  @media (max-width: 900px) {
    .readout, .close__text, .close__title { grid-column: 1 / -1; grid-row: auto; }
    .readout__bars { grid-template-columns: 1fr; }
    /* Stacked, a label's descenders keep clear of the first row of dots beneath it. */
    .readout__bars li { grid-template-columns: 1fr auto; grid-template-areas: 'label value' 'track track'; row-gap: 6px; }
    .readout__label { grid-area: label; }
    .readout__track { grid-area: track; }
    .readout__value { grid-area: value; }
    .foot p:first-child, .foot p:last-child { grid-column: 1 / -1; text-align: left; }
  }
</style>
