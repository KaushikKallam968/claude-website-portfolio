---
/**
 * Authored diagrams of each piece of work's central idea. They illustrate the reasoning; they are not
 * internal artifacts, and each says so. watched. uses real screenshots from its public App Store listing.
 */
import { Image } from 'astro:assets';
import taste from '../assets/watched/taste-analytics.png';
import rec from '../assets/watched/ai-recommendation.png';
import search from '../assets/watched/search.png';

interface Props {
  kind: 'instrumentation' | 'ai-evaluation' | 'discord' | 'mexico' | 'watched';
  compact?: boolean;
}
const { kind, compact = false } = Astro.props;
---

<figure class:list={['fig', `fig--${kind}`, { 'fig--compact': compact }]} data-fig={kind}>
  {kind === 'instrumentation' && (
    <div class="fig__stage inst">
      <div class="inst__page" aria-hidden="true">
        <p class="inst__bar"><span class="inst__field" style="--i:0">Search accounts</span></p>
        <div class="inst__cols">
          <p class="inst__bar"><span class="inst__field" style="--i:1">Search payees</span></p>
          <p class="inst__bar"><span class="inst__field" style="--i:2">Search help</span></p>
        </div>
        <p class="inst__bar"><span class="inst__btn">Send payment</span></p>
      </div>
      <ol class="inst__log mono" aria-hidden="true">
        <li style="--i:0"><span>event</span> search</li>
        <li style="--i:1"><span>event</span> search</li>
        <li style="--i:2"><span>event</span> search</li>
        <li class="inst__none" style="--i:3"><span>event</span> none</li>
      </ol>
    </div>
    <figcaption class="fig__cap">
      <span>Three different searches produce one identical record, and the button produces none. Quality and coverage are different problems.</span>
      <span class="fig__note mono">Illustration of the idea, not the internal dashboard.</span>
    </figcaption>
  )}

  {kind === 'ai-evaluation' && (
    <div class="fig__stage trace" aria-hidden="true">
      <ol class="trace__row">
        <li style="--i:0">Plan</li><li style="--i:1">Call tool</li><li class="trace__ok" style="--i:2">Correct answer</li>
      </ol>
      <ol class="trace__row trace__row--long">
        <li style="--i:0">Plan</li><li style="--i:1">Call tool</li><li class="trace__waste" style="--i:2">Call tool again</li><li class="trace__waste" style="--i:3">Re-plan</li><li class="trace__waste" style="--i:4">Call tool</li><li class="trace__ok" style="--i:5">Correct answer</li>
      </ol>
    </div>
    <figcaption class="fig__cap">
      <span>Both runs are correct. Only one of them is efficient, and judging the result alone can’t tell them apart.</span>
      <span class="fig__note mono">Illustration. Internal signals and definitions are not shown.</span>
    </figcaption>
  )}

  {kind === 'discord' && (
    <div class="fig__stage deck">
      <table class="deck__table">
        <thead><tr><th scope="col">Concept</th><th scope="col">What decided it</th><th scope="col">Next step</th></tr></thead>
        <tbody>
          <tr style="--i:0"><th scope="row">Homework help</th><td>Answers had to arrive inside Discord, not elsewhere</td><td><span class="deck__go">Advance</span></td></tr>
          <tr style="--i:1"><th scope="row">Math solving</th><td>Typing an equation was the barrier</td><td><span class="deck__iter">Iterate first</span></td></tr>
          <tr style="--i:2"><th scope="row">Quiz generation</th><td>Explain wrong answers, add a timer</td><td><span class="deck__go">Toward alpha</span></td></tr>
        </tbody>
      </table>
    </div>
    <figcaption class="fig__cap">
      <span>The same interest in AI help led to three different decisions, each settled by an input or output detail.</span>
    </figcaption>
  )}

  {kind === 'mexico' && (
    <div class="fig__stage xl" aria-hidden="true">
      <p class="xl__query"><span class="xl__lang mono">ES</span><span class="xl__typed">¿Cómo resuelvo una ecuación cuadrática?</span></p>
      <p class="xl__arrow mono">search crosses the language boundary</p>
      <p class="xl__result"><span class="xl__lang mono">EN</span><span>How to solve a quadratic equation</span></p>
    </div>
    <figcaption class="fig__cap">
      <span>Students searched in both languages, so a Spanish question should be able to find an English answer.</span>
      <span class="fig__note mono">Illustration of the recommendation, not the chegg.mx interface.</span>
    </figcaption>
  )}

  {kind === 'watched' && (
    <div class="fig__stage phones">
      <Image src={taste} alt="watched. taste analytics: rated titles, genres and personal rankings." widths={[360, 540, 720]} sizes="(max-width: 900px) 40vw, 18vw" class="phone phone--a" loading="lazy" />
      <Image src={rec} alt="A watched. recommendation that explains why it suggests Blade Runner 2049, based on films the person liked." widths={[360, 540, 720]} sizes="(max-width: 900px) 40vw, 18vw" class="phone phone--b" loading="lazy" />
      {!compact && <Image src={search} alt="watched. search with trending films and shows." widths={[360, 540, 720]} sizes="(max-width: 900px) 40vw, 18vw" class="phone phone--c" loading="lazy" />}
    </div>
    <figcaption class="fig__cap">
      <span>Screens from the App Store listing, before the pause.</span>
    </figcaption>
  )}
</figure>

<style>
  .fig { margin: 0; display: grid; gap: 14px; }
  .fig__stage {
    background: var(--paper-2);
    padding: clamp(18px, 2.4vw, 32px);
    position: relative;
    overflow: hidden;
  }
  .fig__cap { display: grid; gap: 6px; font-size: 0.875rem; color: var(--ink-2); max-width: 52ch; }
  .fig__note { color: var(--note); font-size: 0.6875rem; }

  /* Instrumentation: three searches, one record */
  .inst { display: grid; grid-template-columns: 1.4fr 1fr; gap: 20px; align-items: center; }
  .inst__page { display: grid; gap: 10px; border: 1px solid var(--rule); padding: 14px; background: var(--paper); }
  .inst__cols { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .inst__bar { margin: 0; }
  .inst__field, .inst__btn {
    display: block;
    font-size: 0.75rem;
    color: var(--ink-3);
    border: 1px solid var(--ink-3);
    padding: 7px 9px;
    position: relative;
  }
  .inst__btn { border-style: dashed; color: var(--ink-2); width: max-content; }
  .inst__field::after, .inst__btn::after {
    content: '';
    position: absolute;
    inset: -1px;
    border: 1.5px solid var(--note);
    opacity: 0;
  }
  .inst__log { display: grid; gap: 6px; color: var(--note); }
  .inst__log li { padding: 5px 8px; border-left: 2px solid var(--note); background: var(--note-soft); }
  .inst__log span { color: var(--ink-3); margin-right: 8px; }
  .inst__none { border-left-style: dashed !important; background: transparent !important; color: var(--ink-3); }

  /* AI evaluation: two traces, same answer */
  .trace { display: grid; gap: 14px; }
  .trace__row { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
  .trace__row li {
    font-size: 0.75rem;
    padding: 6px 9px;
    border: 1px solid var(--ink-3);
    background: var(--paper);
    position: relative;
  }
  .trace__row li + li::before { content: '→'; position: absolute; left: -12px; color: var(--ink-3); top: 50%; translate: 0 -50%; font-size: 0.7rem; }
  .trace__row li + li { margin-left: 8px; }
  .trace__waste { border-color: var(--note) !important; color: var(--note); background: var(--note-soft) !important; }
  .trace__ok { border-color: var(--ink) !important; font-weight: 520; }

  /* Discord: a decision table */
  .deck__table { width: 100%; border-collapse: collapse; font-size: 0.875rem; }
  .deck__table th, .deck__table td { text-align: left; padding: 10px 12px 10px 0; border-top: 1px solid var(--rule); vertical-align: top; }
  .deck__table thead th { font-family: var(--mono); font-size: 0.6875rem; font-weight: 400; color: var(--ink-3); border-top: 0; }
  .deck__table tbody th { font-weight: 520; }
  .deck__go, .deck__iter { font-family: var(--mono); font-size: 0.6875rem; white-space: nowrap; color: var(--note); }
  .deck__iter { color: var(--ink); border-bottom: 1px dashed; }

  /* Mexico: a search that crosses languages */
  .xl { display: grid; gap: 10px; }
  .xl__query, .xl__result { margin: 0; display: flex; gap: 12px; align-items: center; background: var(--paper); border: 1px solid var(--ink-3); padding: 10px 12px; font-size: 0.9375rem; }
  .xl__result { border-color: var(--note); }
  .xl__lang { color: var(--note); border: 1px solid currentColor; padding: 1px 5px; font-size: 0.625rem; }
  .xl__arrow { margin: 0 0 0 14px; color: var(--note); font-size: 0.6875rem; padding-left: 16px; border-left: 1.5px solid var(--note); }
  .xl__typed { border-right: 1.5px solid var(--ink); padding-right: 2px; white-space: nowrap; overflow: hidden; }

  /* watched.: real screens */
  .phones { display: flex; justify-content: center; align-items: flex-end; gap: 0; padding-bottom: 0; min-height: 280px; }
  .phone { width: 34%; height: auto; border-radius: 16px; box-shadow: 0 1px 0 var(--rule); }
  .phone--a { translate: 12% 8%; rotate: -4deg; }
  .phone--b { position: relative; z-index: 2; }
  .phone--c { translate: -12% 8%; rotate: 4deg; }
  .fig--compact .phone { width: 42%; }

  /* Motion: each figure plays once when it enters (motion.ts adds .is-in). */
  :global(html.js) .inst__log li, :global(html.js) .trace__row li, :global(html.js) .deck__table tbody tr { opacity: 0; translate: 0 8px; }
  :global(html.js) .xl__result, :global(html.js) .xl__arrow { opacity: 0; translate: 0 8px; }
  :global(.fig.is-in) .inst__log li,
  :global(.fig.is-in) .trace__row li,
  :global(.fig.is-in) .deck__table tbody tr {
    opacity: 1; translate: 0 0;
    transition: opacity 0.7s var(--ease-out), translate 0.9s var(--ease-out);
    transition-delay: calc(var(--i) * 0.28s + 0.35s);
  }
  :global(.fig.is-in) .inst__field::after, :global(.fig.is-in) .inst__btn::after { animation: ping 1.2s var(--ease-out) both; }
  :global(.fig.is-in) .inst__field::after { animation-delay: calc(var(--i, 0) * 0.28s + 0.1s); }
  :global(.fig.is-in) .inst__btn::after { animation-delay: 0.94s; border-style: dashed; }
  @keyframes ping { 0% { opacity: 0; } 25% { opacity: 1; } 100% { opacity: 0; } }
  :global(.fig.is-in) .xl__typed { animation: type 1.6s steps(38) 0.2s both, caret 0.8s step-end 1.8s 3; }
  :global(.fig.is-in) .xl__arrow { opacity: 1; translate: 0 0; transition: opacity 0.7s var(--ease-out) 1.9s, translate 0.9s var(--ease-out) 1.9s; }
  :global(.fig.is-in) .xl__result { opacity: 1; translate: 0 0; transition: opacity 0.7s var(--ease-out) 2.2s, translate 0.9s var(--ease-out) 2.2s; }
  @keyframes type { from { max-width: 0; } to { max-width: 38ch; } }
  @keyframes caret { 50% { border-color: transparent; } }
  :global(.fig.is-in) .trace__row--long li { transition-delay: calc(var(--i) * 0.2s + 0.9s); }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .inst__log li, :global(html.js) .trace__row li, :global(html.js) .deck__table tbody tr,
    :global(html.js) .xl__result, :global(html.js) .xl__arrow { opacity: 1; translate: 0 0; }
  }
  @media (max-width: 600px) {
    .inst { grid-template-columns: 1fr; }
  }
</style>
