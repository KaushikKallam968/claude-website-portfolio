<script>
  // The screenshots load as they near the screen, so a page printed before they were scrolled to would carry empty
  // frames. A print asks for them all; nothing else does, so a reader never pays for what they do not scroll to.
  addEventListener('beforeprint', () => document.querySelectorAll<HTMLImageElement>('img[loading="lazy"]').forEach((img) => (img.loading = 'eager')));
</script>
