---
/**
 * A Case's figure told in steps. With motion, the figure holds still on screen while scrolling plays its
 * argument one step at a time; otherwise the figure and its steps simply read top to bottom.
 */
import CaseFigure from './CaseFigure.astro';
import type { FigureKind } from '../data/journey';

interface Props {
  kind: FigureKind;
}
const { kind } = Astro.props;

const steps: Record<FigureKind, [number, string][]> = {
  instrumentation: [
    [0, 'Three search bars on one page.'],
    [0.3, 'Each records the same event: search.'],
    [0.52, 'The button records nothing at all.'],
    [0.74, 'An unclear tag is a quality problem. A missing one is a coverage problem.'],
  ],
  discord: [
    [0, 'Three concepts, each tested with 12 STEM students.'],
    [0.26, 'Homework help: answers had to arrive inside Discord.'],
    [0.48, 'Math solving: entering an equation got in the way.'],
    [0.7, 'Quiz generation: explain wrong answers, add a timer.'],
  ],
  mexico: [
    [0, 'Students searched for help in Spanish and in English.'],
    [0.3, 'So a question asked in Spanish…'],
    [0.54, '…should find its answer in Chegg’s English database.'],
    [0.78, 'The presentation reports that this was implemented on chegg.mx.'],
  ],
  watched: [
    [0, 'Taste analytics: ratings, genres and personal rankings.'],
    [0.34, 'Recommendations that explain themselves.'],
    [0.64, 'Search, with what’s trending.'],
  ],
  'ai-evaluation': [],
};
const list = steps[kind];
---

<div class="scene" data-fig-scene data-steps={JSON.stringify(list.map(([at]) => at))}>
  <div class="scene__stage">
    <CaseFigure kind={kind} scene />
    {list.length > 0 && (
      <ol class="scene__steps" aria-label="The figure, step by step">
        {list.map(([, text], i) => (
          <li data-step={i}>
            <button type="button" class="scene__step" data-step-button={i} data-observe={`figure.${kind}.step${i + 1}`} data-observe-label={`step ${i + 1} of the figure`} data-observe-cannot="Whether the step was clear or you were checking the order.">
              <span class="scene__n num" aria-hidden="true">{i + 1}</span>
              <span>{text}</span>
            </button>
          </li>
        ))}
      </ol>
    )}
  </div>
</div>

<style>
  .scene__stage { display: grid; gap: 22px; }
  .scene__steps { display: grid; gap: 2px; max-width: 64ch; border-top: 1px solid var(--rule); }
  .scene__step {
    display: grid;
    grid-template-columns: 2em 1fr;
    gap: 10px;
    width: 100%;
    padding: 10px 0;
    text-align: left;
    font-size: var(--t-body);
    border-bottom: 1px solid var(--rule);
    position: relative;
  }
  .scene__n { font-family: var(--mono); font-size: var(--t-data); color: var(--ink-3); padding-top: 0.3em; }
  /* The step being shown draws a rule along its top, timed to the step. */
  .scene__step::before {
    content: '';
    position: absolute;
    left: 0; right: 0; top: -1px;
    height: 1px;
    background: var(--ink);
    transform: scaleX(0);
    transform-origin: left;
  }
  :global(html.scenes) .scene__step { color: var(--ink-3); transition: color 0.5s var(--ease-out); }
  :global(html.scenes) .scene__step:hover { color: var(--ink-2); }
  :global(html.scenes) li.is-on .scene__step { color: var(--ink); }
  :global(html.scenes) li.is-on .scene__step::before { transform: scaleX(1); transition: transform var(--step-ms, 1800ms) linear; }
  :global(html.scenes) li.is-on .scene__n { color: var(--note); }
  /* Steps already shown stay a step darker than those still to come, and keep their rule. */
  :global(html.scenes) li.is-done .scene__step { color: var(--ink-2); }
  :global(html.scenes) li.is-done .scene__step::before { transform: scaleX(1); background: var(--rule); }
</style>
