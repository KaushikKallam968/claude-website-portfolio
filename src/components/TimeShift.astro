---
/**
 * Between two Chapters: a scene the reader scrolls through. The map (the Field) flies from one place to
 * the next while the local time rolls from one clock to the other, computed live so the offset is always
 * true, daylight saving included. Without scripts, or with reduced motion, it is a short static band.
 *
 * Scenes are sized by the distance flown. An ocean crossing is a full pinned scene; a domestic hop is a
 * shorter window onto the map that scrolls with the page (60 to 80vh, longer for longer flights).
 */
import type { Chapter } from '../data/journey';
import { distanceKm } from '../lib/geo';
import Arrow from './Arrow.astro';

interface Props {
  from: Chapter;
  to: Chapter;
}
const { from, to } = Astro.props;
const short = (c: Chapter) => c.place.name.split(',')[0];
const reel = Array.from({ length: 30 }, (_, i) => i % 10);
const km = distanceKm([from.place.lon, from.place.lat], [to.place.lon, to.place.lat]);
const far = km > 6000;
const run = 60 + 20 * Math.min(1, Math.max(0, (km - 1000) / 2500));
---

<div
  class:list={['shift', far ? 'shift--far' : 'shift--near']}
  style={far ? undefined : `--run: ${run.toFixed(1)}vh`}
  data-shift
  data-from-id={from.id}
  data-to-id={to.id}
  data-from-tz={from.place.timeZone}
  data-to-tz={to.place.timeZone}
  data-from={short(from)}
  data-to={short(to)}
>
  <div class="shift__stage">
    <p class="shift__route" aria-hidden="true" data-quiet><span>{short(from)}</span><span class="shift__line"><span data-shift-progress></span></span><span>{short(to)}</span></p>
    <div class="shift__clock num" aria-hidden="true" data-quiet>
      {[0, 1].map((i) => (
        <span class="reel" data-reel={i}><span class="reel__strip">{reel.map((d) => <span>{d}</span>)}</span></span>
      ))}
      <span class="shift__colon">:</span>
      {[2, 3].map((i) => (
        <span class="reel" data-reel={i}><span class="reel__strip">{reel.map((d) => <span>{d}</span>)}</span></span>
      ))}
      <span class="shift__day" data-shift-day></span>
    </div>
    <div class="shift__words" data-quiet>
      <p class="shift__text" data-shift-text>From {short(from)} to {short(to)}.</p>
      <a class="shift__next link" href={`#${to.id}`} data-observe={`shift.${to.id}`} data-observe-label={`Continue to ${to.label}`} data-observe-cannot="Whether you wanted to skip the scene or see where it went.">Continue to {to.label} <Arrow to="down" /></a>
    </div>
  </div>
</div>

<style>
  .shift {
    position: relative;
    margin: clamp(90px, 12vw, 200px) var(--margin) 0;
    color: var(--note);
  }
  .shift__stage {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: end;
    gap: 14px clamp(18px, 3vw, 48px);
    padding-top: 16px;
    border-top: 1px solid var(--note);
  }
  .shift__route { display: none; }
  .shift__clock {
    display: flex;
    align-items: flex-start;
    font-size: clamp(3.4rem, 13cqi, 11.5rem);
    line-height: 1;
    letter-spacing: -0.04em;
    font-weight: 440;
    font-variant-numeric: tabular-nums;
    position: relative;
  }
  .shift--far .shift__clock { font-size: var(--t-clock-far); }
  .shift--far .shift__stage { grid-template-columns: 1fr; }
  /* Each reel shows exactly one digit: the window is the digits' cap height, and every digit in the strip
     sits on the same baseline within its cell. */
  .reel { display: inline-block; height: 0.76em; overflow: hidden; width: 0.58em; text-align: center; margin-top: 0.12em; }
  .reel__strip { display: flex; flex-direction: column; }
  .reel__strip span { height: 0.76em; line-height: 0.76em; display: block; }
  .shift__colon { width: 0.3em; text-align: center; translate: 0 -0.06em; }
  .shift__day { font-size: max(0.14em, 0.875rem); letter-spacing: 0; margin: 0.35em 0 0 0.2em; white-space: nowrap; font-weight: 520; }
  .shift__words { display: grid; gap: 10px; padding-bottom: 0.4em; }
  .shift__text { font-size: var(--t-lede); line-height: 1.3; letter-spacing: -0.015em; color: var(--ink); max-width: 18ch; }
  .shift--far .shift__text { max-width: 30ch; }
  .shift__next { color: var(--ink-2); font-size: var(--t-meta); text-decoration: none; justify-self: start; display: inline-flex; gap: 6px; align-items: baseline; }

  /* With the Field running, the band becomes a scene: a tall runway with the clock pinned to the viewport
     while the map flies behind it. */
  :global(html.field) .shift { height: 150vh; margin-top: 0; }
  :global(html.field) .shift__stage {
    position: sticky;
    top: 0;
    height: 100svh;
    align-content: end;
    padding: 0 0 clamp(28px, 6vh, 64px);
    border-top: 0;
  }
  :global(html.field) .shift__route {
    display: flex;
    grid-column: 1 / -1;
    align-self: start;
    margin-top: calc(64px + clamp(18px, 4vh, 40px));
    gap: 12px;
    align-items: center;
    font-family: var(--mono);
    font-size: var(--t-data);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  :global(html.field) .shift__line { position: relative; flex: 1; max-width: 22rem; height: 1px; background: var(--note-soft); }
  :global(html.field) .shift__line span { position: absolute; inset: 0; background: var(--note); transform-origin: left; transform: scaleX(var(--p, 0)); }
  :global(html.field) .shift__stage { grid-template-rows: 1fr auto; }
  /* A domestic hop: no pin. The scene is a band as tall as its runway, and the map shows only inside it. */
  :global(html.field) .shift--near { height: var(--run); margin-top: clamp(40px, 6vw, 96px); }
  :global(html.field) .shift--near .shift__stage { position: relative; height: 100%; padding-bottom: clamp(20px, 4vh, 44px); }
  :global(html.field) .shift--near .shift__route { margin-top: clamp(16px, 3vh, 28px); }

  @media (max-width: 700px) {
    .shift__stage { grid-template-columns: 1fr; }
    .shift__clock { flex-wrap: wrap; }
    :global(html.field) .shift--far { height: 140vh; }
  }
</style>
