---
/**
 * The observation layer. Notes are written by src/scripts/notes.ts from what the visitor does.
 * Not a live region: a screen reader user can read the list when they choose, instead of being interrupted.
 */
---

<aside class="notes" aria-labelledby="notes-title" data-notes>
  <div class="notes__head">
    <h2 id="notes-title" class="notes__title mono">Notes<span class="notes__long"> on this visit</span> <span class="notes__count num" data-notes-count>0</span></h2>
    <button class="notes__toggle mono" type="button" aria-expanded="true" aria-controls="notes-list" data-notes-toggle data-observe="notes.toggle" data-observe-label="the notes switch" data-observe-cannot="Whether the notes were useful or in the way.">Hide</button>
  </div>
  <p class="notes__latest" data-notes-latest aria-hidden="true"></p>
  <p class="notes__about">This page keeps notes on what you do here, and on what each note can’t explain. They stay in your browser.</p>
  <p class="notes__live"><button class="notes__pause mono" type="button" aria-pressed="false" data-live-pause data-observe="live.pause" data-observe-label="Pause live" data-observe-cannot="Whether the moving clocks were a distraction.">Pause live</button> <span>Stops the clocks and the running totals.</span></p>
  <p class="notes__live notes__live--lens" hidden><button class="notes__pause mono" type="button" aria-pressed="false" data-lens-toggle data-observe="lens.toggle" data-observe-label="the tracking lens" data-observe-cannot="What you hoped to find in it.">Show tracking</button> <span>Outlines what this page records, and what it doesn’t.</span></p>
  <ol class="notes__list" id="notes-list" data-notes-list>
    <noscript><li class="notes__empty">With scripts off, there’s nothing to note. That’s an honest dataset too.</li></noscript>
  </ol>
</aside>

<style>
  .notes {
    color: var(--note);
    font-size: var(--t-small);
    line-height: 1.45;
  }
  .notes__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    border-top: 1px solid currentColor;
    padding-top: 10px;
  }
  .notes__title { font-weight: 400; text-transform: uppercase; letter-spacing: 0.06em; }
  .notes__count { display: inline-block; min-width: 2ch; }
  .notes__toggle { text-transform: uppercase; letter-spacing: 0.06em; }
  .notes__toggle:hover { text-decoration: underline; text-underline-offset: 3px; }
  .notes__about { margin: 10px 0 0; color: var(--ink-2); max-width: 34ch; }
  .notes__live { margin: 8px 0 18px; color: var(--ink-3); display: flex; flex-wrap: wrap; gap: 2px 10px; align-items: baseline; }
  .notes__pause { text-transform: uppercase; letter-spacing: 0.06em; color: var(--note); }
  .notes__live--lens { margin-top: -10px; }
  .notes .notes__live[hidden] { display: none !important; }
  .notes__pause:hover { text-decoration: underline; text-underline-offset: 3px; }
  .notes__list { display: grid; gap: 14px; }
  :global(.note) {
    display: grid;
    grid-template-columns: 5.2em 1fr;
    column-gap: 10px;
    padding-top: 10px;
    border-top: 1px dotted color-mix(in oklab, var(--note) 50%, transparent);
  }
  :global(.note__t) { font-family: var(--mono); font-size: 0.6875rem; padding-top: 2px; }
  :global(.note__shows) { color: var(--ink); }
  :global(.note__cannot) { grid-column: 2; font-family: var(--mono); font-size: 0.6875rem; margin-top: 3px; }
  :global(.note__cannot::before) { content: 'can’t tell: '; opacity: 0.7; }
  :global(.note--untagged .note__t::after) { content: ' gap'; }
  .notes__empty { color: var(--ink-2); }
  :global(html.notes-off) .notes__list,
  :global(html.notes-off) .notes__about,
  :global(html.notes-off) .notes__live { display: none; }
  .notes__latest { display: none; }

  /* Phones and tablets: the notes become a one-line ticker under the top bar, showing the latest note.
     It leaves with the top bar while reading down and returns with it, so it never sits over the text
     being read. Show opens the full list as a sheet under the bar. */
  @media (max-width: 1100px) {
    .notes {
      position: fixed;
      top: var(--top-h, 64px);
      left: 0;
      right: 0;
      z-index: 39;
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto;
      column-gap: 12px;
      align-items: baseline;
      background: var(--paper);
      border-bottom: 1px solid var(--note);
      padding: 7px var(--margin) 8px;
      transition: transform 0.7s var(--ease-out);
    }
    :global(html.nav-hidden:not(.notes-open)) .notes { transform: translateY(calc(-100% - var(--top-h, 64px))); }
    .notes__head { display: contents; }
    .notes__title { grid-column: 1; grid-row: 1; white-space: nowrap; }
    .notes__toggle { grid-column: 3; grid-row: 1; }
    .notes__latest {
      display: block;
      grid-column: 2;
      grid-row: 1;
      margin: 0;
      color: var(--ink);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .notes__about, .notes__live, .notes__list { grid-column: 1 / -1; }
    :global(html:not(.notes-open)) .notes__long,
    :global(html:not(.notes-open)) .notes__list,
    :global(html:not(.notes-open)) .notes__about,
    :global(html:not(.notes-open)) .notes__live { display: none; }
    :global(html.notes-peek) .notes__latest { animation: peek 0.6s var(--ease-out) both; }
    @keyframes peek { from { opacity: 0; translate: 0 6px; } }
    :global(html.notes-open) .notes {
      max-height: min(60svh, calc(100svh - var(--top-h, 64px)));
      overflow: auto;
      overscroll-behavior: contain;
      padding-bottom: 16px;
    }
    :global(html.notes-open) .notes__latest { visibility: hidden; }
    :global(html.notes-open) .notes__list { display: grid; }
    :global(html.notes-open) .notes__about { display: block; }
    :global(html.notes-open) .notes__live { display: flex; }
  }
  @media (max-width: 720px) {
    .notes { --top-h: 56px; }
  }
</style>
