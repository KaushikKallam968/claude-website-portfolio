---
import type { Chapter } from '../data/journey';
import EntryRow from './EntryRow.astro';
import TimeShift from './TimeShift.astro';

interface Props {
  chapter: Chapter;
  n: number;
  total: number;
  previous?: Chapter;
}

const { chapter, n, total, previous } = Astro.props;
const pad = (v: number) => String(v).padStart(2, '0');
const lat = `${Math.abs(chapter.place.lat).toFixed(2)}° ${chapter.place.lat >= 0 ? 'N' : 'S'}`;
const lon = `${Math.abs(chapter.place.lon).toFixed(2)}° ${chapter.place.lon >= 0 ? 'E' : 'W'}`;
let entryNo = 0;
const nextNo = () => `${pad(n)}.${++entryNo}`;
---

{previous && <TimeShift from={previous} to={chapter} />}
<section class="chapter" id={chapter.id} aria-labelledby={`chapter-${chapter.id}`} data-chapter-section={chapter.id} data-chapter-title={chapter.label}>
  <header class="chapter__head grid">
    <p class="chapter__no mono num" aria-hidden="true">{pad(n)} / {pad(total)}</p>
    <h2 class="chapter__title" id={`chapter-${chapter.id}`} tabindex="-1">
      <span class="chapter__word" data-split>{chapter.title}</span>
      {chapter.label !== chapter.title && <span class="chapter__qual">{chapter.label.split(': ')[1]}</span>}
    </h2>
    <dl class="chapter__meta mono num">
      <div><dt>Place</dt><dd>{chapter.place.name}</dd></div>
      <div><dt>Coordinates</dt><dd>{lat}<br />{lon}</dd></div>
      <div><dt>Local time</dt><dd><span data-clock={chapter.place.timeZone}>--:--</span> <span data-daylight={`${chapter.place.lat},${chapter.place.lon}`}></span></dd></div>
      <div><dt>Period</dt><dd>{chapter.period}</dd></div>
    </dl>
  </header>

  <div class="chapter__body grid">
    <div class="chapter__text">
      {chapter.lead && <p class="chapter__lead">{chapter.lead}</p>}
      {chapter.intro.map((p) => <p>{p}</p>)}
      {chapter.facts && (
        <ul class="chapter__facts">
          {chapter.facts.map((f) => <li>{f}</li>)}
        </ul>
      )}
    </div>
    {chapter.roles.length > 0 && (
      <ul class="chapter__roles">
        {chapter.roles.map((r) => (
          <li>
            <span class="role__title">{r.title}</span>
            <span class="role__org">{r.org}</span>
            <span class="role__when label">{r.period} · {r.where}</span>
          </li>
        ))}
      </ul>
    )}
  </div>

  {chapter.entries.length > 0 && (
    <ol class="entries grid" aria-label={`Work in ${chapter.label}`}>
      {chapter.entries.map((e) => <EntryRow entry={e} chapter={chapter} index={nextNo()} />)}
    </ol>
  )}

  {chapter.subsections?.map((s) => (
    <div class="sub">
      <div class="chapter__body grid">
        <div class="chapter__text">
          <h3 class="sub__title">{s.heading}</h3>
          {s.text.map((p) => <p>{p}</p>)}
        </div>
        {s.role && (
          <ul class="chapter__roles">
            <li>
              <span class="role__title">{s.role.title}</span>
              <span class="role__org">{s.role.org}</span>
              <span class="role__when label">{s.role.period} · {s.role.where}</span>
            </li>
          </ul>
        )}
      </div>
      <ol class="entries grid" aria-label={s.heading}>
        {s.entries.map((e) => <EntryRow entry={e} chapter={chapter} index={nextNo()} />)}
      </ol>
    </div>
  ))}
</section>

<style>
  .chapter { padding-top: clamp(56px, 8vw, 120px); scroll-margin-top: 64px; }
  .chapter:first-of-type { padding-top: clamp(96px, 14vw, 220px); }
  .chapter__head { align-items: end; row-gap: 18px; }
  .chapter__no { grid-column: 1 / -1; color: var(--note); }
  .chapter__title {
    grid-column: 1 / span 9;
    font-size: clamp(3.25rem, 12.5cqi, 12rem);
    line-height: 0.82;
    letter-spacing: -0.058em;
    font-weight: 520;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.18em;
    outline: none;
  }
  .chapter__qual {
    font-size: 0.24em;
    letter-spacing: -0.02em;
    font-weight: 440;
    color: var(--ink-2);
    transform: translateY(-0.2em);
  }
  .chapter__meta {
    grid-column: 10 / -1;
    display: grid;
    gap: 6px;
    color: var(--ink-2);
    padding-bottom: 0.4em;
  }
  .chapter__meta div { display: grid; grid-template-columns: 7.5em 1fr; gap: 6px; }
  .chapter__meta dt { color: var(--ink-3); }
  .chapter__meta dd { margin: 0; color: var(--ink); }
  .chapter__body { margin-top: clamp(40px, 6vw, 88px); row-gap: 32px; }
  .chapter__text {
    grid-column: 4 / span 6;
    display: grid;
    gap: 0.9em;
    font-size: var(--t-lede);
    line-height: 1.4;
    letter-spacing: -0.012em;
    max-width: 34ch;
  }
  .chapter__lead { color: var(--ink-3); }
  .chapter__facts { display: grid; gap: 6px; font-size: var(--t-body); margin-top: 0.4em; }
  .chapter__facts li { border-top: 1px solid var(--rule); padding-top: 8px; }
  .chapter__roles { grid-column: 10 / -1; display: grid; gap: 18px; align-content: start; font-size: 0.9375rem; }
  .chapter__roles li { display: grid; gap: 2px; border-top: 1px solid var(--ink); padding-top: 10px; }
  .role__title { font-weight: 520; }
  .entries { margin: clamp(40px, 6vw, 80px) var(--margin) 0; padding-inline: 0; border-bottom: 1px solid var(--rule); }
  .sub { margin-top: clamp(56px, 8vw, 120px); }
  .sub__title { font-size: var(--t-lede); font-weight: 520; letter-spacing: -0.02em; margin-bottom: 0.2em; }
  @media (max-width: 900px) {
    .chapter__title, .chapter__meta, .chapter__text, .chapter__roles { grid-column: 1 / -1; }
    .chapter__meta { padding-bottom: 0; }
  }
</style>
