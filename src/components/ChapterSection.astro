---
import { qualifierOf, type Chapter, type Role } from '../data/journey';
import EntryRow from './EntryRow.astro';
import TimeShift from './TimeShift.astro';

interface Props {
  chapter: Chapter;
  previous?: Chapter;
}

const { chapter, previous } = Astro.props;
const qualifier = qualifierOf(chapter);
const lat = `${Math.abs(chapter.place.lat).toFixed(2)}° ${chapter.place.lat >= 0 ? 'N' : 'S'}`;
const lon = `${Math.abs(chapter.place.lon).toFixed(2)}° ${chapter.place.lon >= 0 ? 'E' : 'W'}`;
const groups: { text: string[]; roles: Role[]; heading?: string; entries: Chapter['entries'] }[] = [
  { text: chapter.intro, roles: chapter.roles, entries: chapter.entries },
  ...(chapter.subsections ?? []).map((s) => ({ heading: s.heading, text: s.text, roles: s.role ? [s.role] : [], entries: s.entries })),
];
---

{previous && <TimeShift from={previous} to={chapter} />}
<section class="chapter" id={chapter.id} aria-labelledby={`chapter-${chapter.id}`} data-chapter-section={chapter.id} data-chapter-title={chapter.label} data-place={chapter.place.name.split(',')[0]} data-tz={chapter.place.timeZone}>
  <header class="chapter__head grid">
    <h2 class="chapter__title" id={`chapter-${chapter.id}`} tabindex="-1">
      <span class="visually-hidden">{chapter.label}</span>
      <span class="chapter__word" aria-hidden="true">{chapter.title}</span>
      {qualifier && <span class="chapter__qual" aria-hidden="true">{qualifier}</span>}
    </h2>
    <dl class="chapter__meta mono num">
      <div><dt>Place</dt><dd>{chapter.place.name}</dd></div>
      <div><dt>Coordinates</dt><dd>{lat}<br />{lon}</dd></div>
      <div><dt>Local time</dt><dd><span data-clock={chapter.place.timeZone}>--:--</span> <span data-daylight={`${chapter.place.lat},${chapter.place.lon}`}></span></dd></div>
      <div><dt>Period</dt><dd>{chapter.period}</dd></div>
    </dl>
  </header>

  {groups.map((g, i) => (
    <div class:list={['group', { 'group--sub': i > 0 }]}>
      <div class="chapter__body grid">
        <div class="chapter__text">
          {g.heading && <h3 class="sub__title">{g.heading}</h3>}
          {i === 0 && chapter.lead && <p class="chapter__lead">{chapter.lead}</p>}
          {g.text.map((p) => <p>{p}</p>)}
          {i === 0 && chapter.facts && (
            <ul class="chapter__facts">
              {chapter.facts.map((f) => <li>{f}</li>)}
            </ul>
          )}
        </div>
        {g.roles.length > 0 && (
          <ul class="chapter__roles">
            {g.roles.map((r) => (
              <li>
                <span class="role__title">{r.title}</span>
                <span class="role__org">{r.org}</span>
                <span class="role__when label">{r.period} · {r.where}</span>
              </li>
            ))}
          </ul>
        )}
      </div>
      {g.entries.length > 0 && (
        <ol class="entries grid" aria-label={g.heading ?? `Work in ${chapter.label}`}>
          {g.entries.map((e) => <EntryRow entry={e} chapter={chapter} />)}
        </ol>
      )}
    </div>
  ))}
</section>

<style>
  .chapter { padding-top: clamp(56px, 8vw, 120px); scroll-margin-top: 64px; }
  .chapter:first-of-type { padding-top: clamp(96px, 14vw, 220px); }
  .chapter__head { align-items: end; row-gap: 18px; }
  .chapter__title {
    grid-column: 1 / span 9;
    font-size: clamp(3.25rem, 12.5cqi, 10rem);
    line-height: 0.84;
    letter-spacing: -0.04em;
    font-weight: 520;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.18em;
    outline: none;
  }
  .chapter__qual {
    font-size: 0.24em;
    letter-spacing: -0.02em;
    font-weight: 440;
    color: var(--ink-2);
    transform: translateY(-0.2em);
  }
  .chapter__meta {
    grid-column: 10 / -1;
    display: grid;
    gap: 6px;
    color: var(--ink-2);
    padding-bottom: 0.4em;
  }
  .chapter__meta div { display: grid; grid-template-columns: 7.5em 1fr; gap: 6px; }
  .chapter__meta dt { color: var(--ink-3); }
  .chapter__meta dd { margin: 0; color: var(--ink); }
  .chapter__body { margin-top: clamp(40px, 6vw, 88px); row-gap: 32px; }
  .chapter__text {
    grid-column: 4 / span 6;
    display: grid;
    gap: 0.9em;
    font-size: var(--t-lede);
    line-height: 1.4;
    letter-spacing: -0.012em;
    max-width: 34ch;
  }
  .chapter__lead { color: var(--ink-3); }
  .chapter__facts { display: grid; gap: 6px; font-size: var(--t-body); margin-top: 0.4em; }
  .chapter__facts li { border-top: 1px solid var(--rule); padding-top: 8px; }
  .chapter__roles { grid-column: 10 / -1; display: grid; gap: 18px; align-content: start; font-size: var(--t-meta); }
  .chapter__roles li { display: grid; gap: 2px; border-top: 1px solid var(--ink); padding-top: 10px; }
  .role__title { font-weight: 520; }
  .entries { margin: clamp(40px, 6vw, 80px) var(--margin) 0; padding-inline: 0; border-bottom: 1px solid var(--rule); }
  .group--sub { margin-top: clamp(56px, 8vw, 120px); }
  .sub__title { font-size: var(--t-lede); font-weight: 520; letter-spacing: -0.02em; margin-bottom: 0.2em; }
  @media (max-width: 900px) {
    .chapter__title, .chapter__meta, .chapter__text, .chapter__roles { grid-column: 1 / -1; }
    .chapter__meta { padding-bottom: 0; }
  }
</style>
