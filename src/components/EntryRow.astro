---
import type { Chapter, Entry } from '../data/journey';
import CaseFigure from './CaseFigure.astro';
import Arrow from './Arrow.astro';
import { keepDots, nobrCompounds } from '../lib/format';

interface Props {
  entry: Entry;
  chapter: Chapter;
  /** An Entry is one level below the heading that holds it: a Chapter's (3), or a subsection's (4). */
  level?: 3 | 4;
}

const { entry, chapter, level = 3 } = Astro.props;
const Heading = `h${level}` as 'h3' | 'h4';
const isCase = entry.kind === 'case';
const href = `/work/${entry.id}/`;
---

<li class="entry" id={entry.id} data-entry={entry.id} data-chapter={chapter.id}>
  <div class="entry__main">
    <Heading class="entry__title" id={`entry-${entry.id}-title`}>
      {isCase ? (
        <a
          href={href}
          class="entry__link"
          id={`entry-${entry.id}`}
          data-case-link={entry.id} data-case-title={entry.title}
          data-origin-chapter={chapter.id}
          data-observe={`case.${entry.id}`}
          data-observe-label={entry.title}
          data-observe-cannot="Whether it was the title or the problem that caught your eye."
        >
          <span class="entry__text"><Fragment set:html={nobrCompounds(entry.title)} /></span>
        </a>
      ) : (
        <span id={`entry-${entry.id}`} tabindex="-1"><Fragment set:html={nobrCompounds(entry.title)} /></span>
      )}
    </Heading>
    <p class="entry__context">
      <span>{keepDots(entry.context)}</span>
      {entry.draft && <span class="draft-marker" title="Draft copy awaiting Kaushik’s confirmation">Draft</span>}
    </p>
    <div class="entry__preview">
      {entry.preview.map((p) => <p><Fragment set:html={nobrCompounds(p)} /></p>)}
    </div>
    {entry.more && (
      <div class="entry__more" id={`more-${entry.id}`} data-more>
        {entry.more.map((p) => <p>{p}</p>)}
      </div>
    )}
    <dl class="entry__facts">
      <div><dt>Contribution</dt><dd>{entry.contribution}</dd></div>
      <div><dt>Status</dt><dd>{keepDots(entry.status)}</dd></div>
    </dl>
    {isCase ? (
      <a class="entry__action link link--under" href={href} tabindex="-1" aria-hidden="true" data-case-link={entry.id} data-case-title={entry.title} data-origin-chapter={chapter.id} data-observe={`case.${entry.id}`} data-observe-label={entry.title} data-observe-cannot="Whether it was the title or the problem that caught your eye.">
        {entry.action} <Arrow />
      </a>
    ) : entry.more ? (
      <button
        class="entry__action link link--under"
        type="button"
        hidden
        aria-expanded="true"
        aria-controls={`more-${entry.id}`}
        data-more-toggle
        data-observe={`more.${entry.id}`}
        data-observe-label={entry.action}
        data-observe-cannot="Whether the summary will be enough."
      >
        {entry.action} <Arrow to="down" />
      </button>
    ) : null}
  </div>
  {entry.figure && (
    <div class="entry__side">
      <CaseFigure kind={entry.figure} compact />
    </div>
  )}
</li>

<style>
  .entry {
    display: grid;
    grid-template-columns: subgrid;
    grid-column: 1 / -1;
    padding-block: clamp(26px, 3.4vw, 44px);
    position: relative;
    --line: 1;
    /* A link to an Entry lands its title clear of the bar (and, on small screens, the notes ticker), as the route index does. */
    scroll-margin-top: 96px;
  }
  .entry::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: var(--rule);
    transform: scaleX(var(--line));
    transform-origin: left;
  }
  .entry__main { grid-column: 1 / span 7; }
  .entry__side { grid-column: 8 / -1; align-self: start; }
  .entry__title {
    font-size: var(--t-h3);
    line-height: 1.08;
    letter-spacing: -0.028em;
    font-weight: 520;
    max-width: 22ch;
  }
  /* Only the words slide: a transformed ancestor would shrink the row-wide link target to itself. 18ch is the
     Case heading's measure, and the leading is close to its 0.92, so a long title wraps the same way and its
     lines sit alike at both ends of the transition (a looser line would show as two titles mid-flight). */
  .entry__text { display: inline-block; max-width: 18ch; line-height: 0.95; transition: translate 0.8s var(--ease-out); }
  .entry__link { text-decoration: none; }
  .entry__link:focus-visible { outline: none; }
  /* The ring stands clear of the text, including at a phone's edge. */
  .entry:has(.entry__link:focus-visible) { outline: 2px solid var(--note); outline-offset: 8px; }
  .entry__context { margin-top: 8px; font-size: var(--t-meta); color: var(--ink-3); display: flex; flex-wrap: wrap; gap: 4px 12px; align-items: center; }
  .entry__preview, .entry__more { display: grid; gap: 0.8em; max-width: 60ch; color: var(--ink-2); margin-top: 18px; }
  .entry__more { margin-top: 0.8em; color: var(--ink); }
  .entry__more[hidden] { display: none; }
  .entry__facts { margin: 24px 0 0; display: grid; grid-template-columns: 1fr 1fr; gap: 12px var(--gutter); max-width: 60ch; }
  .entry__facts dt { font-size: var(--t-small); color: var(--ink-3); }
  .entry__facts dd { margin: 2px 0 0; font-size: var(--t-meta); }
  .entry__action { display: inline-flex; gap: 8px; align-items: baseline; position: relative; z-index: 2; margin-top: 22px; font-weight: 520; text-align: left; }
  .entry__action[hidden] { display: none; }
  .entry:hover :global(.arrow) { translate: 6px 0; }
  button.entry__action:hover :global(.arrow) { translate: 0 3px; }
  button[aria-expanded='true'] :global(.arrow) { rotate: -90deg; }
  .entry:has(.entry__link) { cursor: pointer; }
  .entry:has(.entry__link):hover .entry__text { translate: 8px 0; }
  /* A press shows at once, though a mouse click waits 240ms to open, in case it is the start of a double click. */
  .entry:has(.entry__link):active .entry__text { opacity: 0.62; transition: translate 0.8s var(--ease-out), opacity 0.08s linear; }

  @media (max-width: 1100px) { .entry { scroll-margin-top: 132px; } }
  @media (max-width: 900px) {
    .entry__main, .entry__side { grid-column: 1 / -1; }
    .entry__side { margin-top: 26px; }
  }
  @media (max-width: 520px) {
    .entry__facts { grid-template-columns: 1fr; }
  }
</style>
