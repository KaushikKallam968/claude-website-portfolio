---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Current section, for aria-current in the navigation. */
  current?: 'journey' | 'work' | 'resume' | 'contact';
  /** The page's main content id for the skip link. */
  mainId?: string;
}

const {
  title,
  description = 'Kaushik Kallam, Senior Quantitative UX Researcher in New York. Research on behavior, instrumentation, AI evaluation and learning products, and the places along the way.',
  current,
  mainId = 'main',
} = Astro.props;

const nav = [
  { id: 'journey', label: 'Journey', href: '/#journey-index' },
  { id: 'work', label: 'Work', href: '/work/' },
  { id: 'resume', label: 'Résumé', href: '/resume/' },
  { id: 'contact', label: 'Contact', href: '/#contact' },
] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ecece8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121211" media="(prefers-color-scheme: dark)" />
    <!-- Both schemes are designed, so a phone in dark mode paints its first frame dark rather than flashing white. -->
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- iOS draws its home-screen icon from a PNG on an opaque background; it ignores the SVG. -->
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/switzer-variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/fragment-mono.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {Astro.site && (
      <>
        <meta property="og:image" content={new URL('/og.png', Astro.site).href} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      // Scripts are on: allow entrance states that hide text until motion reveals it.
      document.documentElement.classList.add('js');
      // The home page will draw its Field (WebGL): lay the page out for it from the first frame, so scroll
      // positions stay stable. motion.ts removes the class if the Field cannot start.
      try {
        // High-contrast (forced colours) keeps the plain page: the Field draws in colours the system cannot adapt.
        if (location.pathname === '/' && 'WebGL2RenderingContext' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches && !matchMedia('(forced-colors: active)').matches) {
          document.documentElement.classList.add('field');
        }
      } catch (e) {}
      try {
        // The notes open by default on the journey only; on reading pages they start folded to one line
        // unless the visitor opened them this visit. Once they have explained themselves, later pages skip it.
        var notesPref = sessionStorage.getItem('kk:notes');
        if (notesPref === 'true' || (notesPref === null && location.pathname !== '/')) document.documentElement.classList.add('notes-off');
        if (sessionStorage.getItem('kk:notes-known') === 'true') document.documentElement.classList.add('notes-known');
        if (sessionStorage.getItem('kk:paused') === 'true') document.documentElement.classList.add('live-paused');
      } catch (e) {}
      // Arriving at a Case from its row: the new page opens out of the row's outline (see global.css).
      // This has to be registered before first render, so it lives here rather than in a module.
      // Leaving a Case, its heading travels back to the title it came from, when that title is on screen on the
      // next page; otherwise the heading simply leaves with the page.
      addEventListener('pageswap', function (e) {
        var main = document.querySelector('main[data-case]');
        try { if (e.viewTransition && main) sessionStorage.setItem('kk:vt-case', main.getAttribute('data-case')); } catch (err) {}
      });
      addEventListener('pagereveal', function (e) {
        var d = document.documentElement;
        var raw = null;
        var back = null;
        try {
          raw = sessionStorage.getItem('kk:expand'); sessionStorage.removeItem('kk:expand');
          back = sessionStorage.getItem('kk:vt-case'); sessionStorage.removeItem('kk:vt-case');
        } catch (err) {}
        var titles = document.querySelectorAll('.entry__text, .row__text');
        for (var i = 0; i < titles.length; i++) titles[i].style.viewTransitionName = '';
        if (e.viewTransition && back && !raw) {
          var t = document.querySelector('.entry__link[data-case-link="' + back + '"] .entry__text, .row__link[data-case-link="' + back + '"] .row__text');
          var tr = t && t.getBoundingClientRect();
          if (tr && tr.bottom > 0 && tr.top < innerHeight) {
            t.style.viewTransitionName = 'case-' + back;
            d.classList.add('vt-return');
            e.viewTransition.finished.finally(function () { t.style.viewTransitionName = ''; d.classList.remove('vt-return'); });
          }
        }
        if (!e.viewTransition || !raw) return;
        try {
          var r = JSON.parse(raw);
          var px = function (v) { return Math.max(0, Math.round(v)) + 'px'; };
          d.style.setProperty('--vt-from', 'inset(' + px(r.top) + ' ' + px(r.right) + ' ' + px(r.bottom) + ' ' + px(r.left) + ')');
          d.classList.add('vt-expand');
          e.viewTransition.finished.finally(function () { d.classList.remove('vt-expand'); });
        } catch (err) {}
      });
      // Failsafe: if the motion bundle never runs, reveal everything that waits for it.
      setTimeout(function () {
        var d = document.documentElement;
        d.classList.add('motion-done');
        if (!d.classList.contains('field-on')) d.classList.remove('field');
      }, 5000);
    </script>
  </head>
  <body>
    <a class="skip" href={`#${mainId}`}>Skip to content</a>
    <header class="top grid" data-top>
      <a class="top__name" href="/" aria-label="Kaushik Kallam, home" data-observe="nav.home" data-observe-label="my name in the top bar" data-observe-cannot="Whether you wanted to start over.">Kaushik Kallam</a>
      <p class="top__where label num" aria-hidden="true" data-top-where><span data-top-place>New York</span> <span data-clock="America/New_York">--:--</span></p>
      <nav class="top__nav" aria-label="Primary">
        {nav.map((n) => (
          <a class="link" href={n.href} aria-current={current === n.id ? 'page' : undefined} data-observe={`nav.${n.id}`} data-observe-label={n.label} data-observe-cannot="Where you were hoping it would take you.">
            {n.label}
          </a>
        ))}
      </nav>
    </header>
    <slot />
    <slot name="notes" />
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>

<style>
  .top {
    position: fixed;
    inset: 0 0 auto;
    z-index: 40;
    height: 64px;
    align-items: center;
    font-size: var(--t-meta);
    background: var(--paper);
    border-bottom: 1px solid transparent;
    transition: transform 0.7s var(--ease-out), border-color 0.4s linear;
  }
  :global(html.nav-hidden) .top { transform: translateY(-100%); }
  :global(html.scrolled) .top { border-bottom-color: var(--rule); }
  .top__name {
    grid-column: 1 / span 3;
    justify-self: start;
    text-decoration: none;
    font-weight: 560;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .top__where {
    grid-column: 4 / span 3;
    margin: 0;
    display: flex;
    gap: 0.6em;
  }
  .top__nav {
    grid-column: 7 / -1;
    display: flex;
    justify-content: flex-end;
    gap: clamp(14px, 2vw, 32px);
  }
  .top__nav a { text-decoration: none; }
  .top__nav a[aria-current='page'] { background-size: 100% 1px; }
  :global(html.at-contact) .top__nav a[aria-current='page'] { background-size: 0 1px; }
  :global(html.at-contact) .top__nav a[href='/#contact'] { background-size: 100% 1px; }
  @media (max-width: 720px) {
    .top { height: 56px; font-size: var(--t-fine); display: flex; justify-content: space-between; gap: 12px; }
    .top__where { display: none; }
    .top__nav { gap: 12px; }
  }
  /* The narrowest phones keep the name and all four links on one line. */
  @media (max-width: 400px) {
    .top { font-size: var(--t-small); gap: 8px; }
  }
  /* Room for the notes ticker that sits under the top bar on smaller screens. */
  @media (max-width: 1100px) {
    :global(body:has(.notes)) { padding-top: 44px; }
  }
</style>
